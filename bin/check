#!/usr/bin/env bash
# bin/check —— pencil-bridge 技能包结构校验（零依赖）
set -euo pipefail

REPO_ROOT="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"
SKILLS_DIR="${PENCIL_BRIDGE_SKILLS_DIR:-$REPO_ROOT/skills}"

FAILED=0
FAIL_COUNT=0
fail() { printf 'FAIL: %s\n' "$1" >&2; FAILED=1; FAIL_COUNT=$((FAIL_COUNT+1)); }
ok()   { printf 'ok:   %s\n' "$1"; }

NAME_RE='^[a-z0-9]+(-[a-z0-9]+)*$'
REFS=(mcp-toolbox document-routing write-safety design-map assets-extraction
      init-and-mcp stack-flutter stack-kotlin stack-web)
# 五个技能目录是硬编码的：整个技能目录缺失也必须失败（glob 会静默跳过）
SKILL_DIRS=(pencil-bridge pencil-init pencil-map pencil-sync pencil-assets)

# 绝对路径检测：通用形态。先剥掉 URL（http(s)://…）否则文档链接会被误判；
# 不列 usr，以免误伤 #!/usr/bin/env bash。本正则字符串是检测规则，不是机器路径。
ABS_PATH_RE='(^|[^A-Za-z0-9._-])/(Users|home|opt|var|tmp|etc|private)/'
has_abs_path() { # $1=file
  local hits
  hits="$(sed -E 's#https?://[^[:space:]]*#URL#g' "$1" 2>/dev/null \
          | grep -E "$ABS_PATH_RE" || true)"
  [ -n "$hits" ]
}

# 复刻 DSH 的 frontmatter 读取：只看首个 --- ... --- 块
fm_field() { # $1=file $2=key
  awk -v key="$2" '
    NR==1 && $0!="---" { exit }
    NR==1 { next }
    /^---[[:space:]]*$/ { exit }
    { if (match($0, "^" key "[[:space:]]*:")) {
        sub("^" key "[[:space:]]*:[[:space:]]*", ""); print; exit } }
  ' "$1"
}

# 键是否出现在 frontmatter 内。DSH 只读 frontmatter，正文提及同名键不算问题。
fm_has_key() { # $1=file $2=key
  awk -v key="$2" '
    NR==1 && $0!="---" { exit 1 }
    NR==1 { next }
    /^---[[:space:]]*$/ { exit }
    $0 ~ "^" key "[[:space:]]*:" { found=1; exit }
    END { exit(found ? 0 : 1) }
  ' "$1"
}

[ -d "$SKILLS_DIR" ] || { echo "FAIL: skills 目录不存在: $SKILLS_DIR" >&2; exit 1; }

# 五个期望技能目录缺一不可
for d in "${SKILL_DIRS[@]}"; do
  [ -d "$SKILLS_DIR/$d" ] || fail "缺技能目录: $d"
done

shopt -s nullglob

# skills/ 直属的 .md（不属于任何技能目录）同样要扫
for f in "$SKILLS_DIR"/*.md; do
  has_abs_path "$f" || continue
  fail "$(basename "$f") 出现绝对路径引用（仓库克隆到别处即失效）"
done

for dir in "$SKILLS_DIR"/*/; do
  name="$(basename "$dir")"
  skill_md="$dir/SKILL.md"
  n0="$FAIL_COUNT"

  if [ ! -f "$skill_md" ]; then fail "$name: 缺 SKILL.md"; continue; fi

  fm_name="$(fm_field "$skill_md" name || true)"
  fm_desc="$(fm_field "$skill_md" description || true)"

  [ -n "$fm_name" ] || fail "$name: frontmatter 缺 name"
  [ -n "$fm_desc" ] || fail "$name: frontmatter 缺 description"

  if [ -n "$fm_name" ]; then
    [[ "$fm_name" =~ $NAME_RE ]] || fail "$name: name '$fm_name' 不合 kebab-case"
    [ "$fm_name" = "$name" ] || fail "$name: 目录名与 frontmatter name '$fm_name' 不一致"
    case "$fm_name" in _*) fail "$name: 禁止 _ 前缀技能名";; esac
  fi

  for legacy in disableModelInvocation modelInvocable userInvocable; do
    if fm_has_key "$skill_md" "$legacy"; then
      fail "$name: 含 legacy 键 $legacy（DSH 会丢弃整个技能）"
    fi
  done

  for banned in allowed-tools argument-hint; do
    if fm_has_key "$skill_md" "$banned"; then
      fail "$name: 使用 $banned（只在 Claude 生效，破坏三 harness 一致性）"
    fi
  done

  # 该技能目录下所有 .md（含 references/ 与任意子目录）都不得出现绝对路径
  while IFS= read -r mdfile; do
    has_abs_path "$mdfile" || continue
    fail "$name: ${mdfile#"$SKILLS_DIR"/} 出现绝对路径引用（仓库克隆到别处即失效）"
  done < <(find "$dir" -type f -name '*.md' | sort)

  # 悬空 reference 必须计入本技能 finding，否则会出现「ok: X」与「FAIL: X …」并存
  # 的自相矛盾输出。只对五个期望技能（含 hub）检查，保持 (c) 的覆盖范围不变。
  case " ${SKILL_DIRS[*]} " in
    *" $name "*)
      while read -r ref; do
        [ -z "$ref" ] && continue
        [ -f "$SKILLS_DIR/pencil-bridge/references/$ref" ] \
          || fail "$name 引用了不存在的 reference: $ref"
      done < <(grep -oE '\.\./pencil-bridge/references/[a-z0-9-]+\.md' "$skill_md" \
                 | sed 's#.*/##' | sort -u)
      ;;
  esac

  # 只有本技能无任何 finding 时才报 ok
  if [ "$FAIL_COUNT" -eq "$n0" ]; then ok "$name"; fi
done

for r in "${REFS[@]}"; do
  [ -f "$SKILLS_DIR/pencil-bridge/references/$r.md" ] \
    || fail "缺 reference: references/$r.md"
done

if [ "$FAILED" -eq 0 ]; then echo "全部通过。"; else echo "存在失败项。" >&2; fi
exit "$FAILED"
